% Sources that are NOT in the literature catalogue (study/catalog.md): a provided document, a
% standard, a rulebook. Hand-written BibTeX entries, in any order. Shared by every article:
% study/scripts/build_bibliography.py copies only the entries an article actually cites into
% that article's own references.bib. Do not cite catalogued papers from here: they are written
% from the catalog and cited by the key the script derives (first author's surname + year).
%
% key1 is a placeholder so a fresh template resolves its placeholder citation. Delete it, and
% the \cite{key1} in articles/review/sections/related_work.tex, once the first real citation
% is in.

@misc{key1,
  author = {Author},
  title = {{Title: replace with the first earlier review}},
  year = {Year},
}
