# Source PDFs: kept local only. Large binaries + copyright, not repo material.
/study/PDFs/**
!/study/PDFs/.gitkeep

# Python
.venv/
__pycache__/
*.pyc

# OS
.DS_Store
Thumbs.db

# Worker reports saved for the coordinator's merge: ephemeral
/study/.batch/

# OCR work area: page images, requests and the page ledger (ephemeral)
/study/.ocr/

# Local switch: usage logging off in the template's own working copy
/.claude/no-usage-log

# Generated status views (python study/scripts/status.py --write, or /where)
/STATUS.svg
/STATUS.md

# Built articles: PDFs directly in articles/, LaTeX auxiliary files in articles/.build/
/articles/*.pdf
/articles/.build/
